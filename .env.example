APP_NAME=TLMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
HASH_VERIFY=true
HASH_REHASH_ON_LOGIN=true
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tlms
DB_USERNAME=tlms
DB_PASSWORD=
# Use mysql for MySQL 8.4 or mariadb for MariaDB 10.11.
TLMS_EXPECTED_DB_VENDOR=mysql
# For CLI preflight, set this to the domain's exact document-root path (Laravel public/).
TLMS_EXPECTED_DOCUMENT_ROOT=
# Generate 32 random bytes locally (e.g. php -r 'echo rtrim(strtr(base64_encode(random_bytes(32)), "+/", "-_"), "="), PHP_EOL;'), set once, then remove after bootstrap.
TLMS_BOOTSTRAP_TOKEN=
TLMS_VENDOR_LEGAL_NAME=Tinlance Limited
TLMS_VENDOR_DISPLAY_NAME=Tinlance
# Generate 32 random bytes as base64url. Keep stable: changing this invalidates registered passkeys.
PASSKEYS_USER_HANDLE_SECRET=
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=licenses@example.com
MAIL_FROM_NAME=TLMS
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
AUTH_PASSWORD_TIMEOUT=900
# Fresh TOTP/passkey assurance lifetime for privileged mutations (seconds).
TLMS_STEP_UP_TTL_SECONDS=300
