APP_NAME=TLMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1
HASH_VERIFY=true
HASH_REHASH_ON_LOGIN=true
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tlms
DB_USERNAME=tlms
DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
